# ===== Application =====
# 后端监听端口（前端开发代理默认指向 3000）
PORT=3000
NODE_ENV=development

# ===== Database =====
# mysql（默认，符合项目设计）或 sqlite（仅用于本机无 MySQL 时验证流程）
DB_TYPE=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=
DB_DATABASE=sticker_finder
# Demo 阶段使用 TypeORM synchronize 自动建表；生产环境应改为 false 并使用迁移。
DB_SYNCHRONIZE=true
# 启动时自动执行未运行的迁移（生产建议 false，改为手动执行 npm run migration:run）
DB_MIGRATIONS_RUN=false
# DB_TYPE=sqlite 时的数据库文件路径
SQLITE_PATH=data/sticker-finder.sqlite

# ===== 采集模式与本地测试数据 =====
# fixture：只读本地测试数据，禁止任何外部数据接口
# live：允许真实采集（仍需下面的显式开关，并由用户主动发起）
SEARCH_DATA_MODE=fixture
# 真实采集的显式开关；必须与 SEARCH_DATA_MODE=live 同时满足才会发请求
LIVE_PROVIDER_REQUESTS_ENABLED=false
# 本地测试数据目录（相对 backend 运行目录）
FIXTURE_DIR=test/fixtures/raw

# ===== 抖音第三方数据服务：Qovia =====
QOVIA_API_KEY=
QOVIA_BASE_URL=https://api.qovia.ai

# ===== 小红书第三方数据服务：OKData =====
OKDATA_API_KEY=
OKDATA_BASE_URL=https://api.okdata.online

# ===== 数据源选择模式 =====
# PRIMARY（默认）：每个平台只跑主数据源
# PARALLEL：平台下所有渠道都跑，便于人工对照
# FALLBACK：主数据源未配置/失败后，按渠道顺序尝试备用来源（每个渠道仅一次）
DATA_SOURCE_MODE=PRIMARY

# ===== EveryInfra 统一数据服务 =====
# 淘宝 / 抖音 / 小红书 / 1688 共用同一把 Key 和同一个入口：POST /api/v1/social
# 留空时相关渠道返回 NOT_CONFIGURED，不会发送任何请求，也不会使用模拟商品数据
EVERYINFRA_API_KEY=
EVERYINFRA_BASE_URL=https://api.everyinfra.com
EVERYINFRA_ENABLED=true

# 平台开关（false 时该平台渠道不会发请求）
EVERYINFRA_TAOBAO_ENABLED=true
EVERYINFRA_DOUYIN_ENABLED=true
EVERYINFRA_XIAOHONGSHU_ENABLED=true
EVERYINFRA_ALIBABA1688_ENABLED=true

# 分页与条数：第一版默认只请求第一页；淘宝单页最多 20 条；1688 默认 20 条
EVERYINFRA_TAOBAO_MAX_PAGES=1
EVERYINFRA_XIAOHONGSHU_MAX_PAGES=1
EVERYINFRA_ALIBABA1688_MAX_RESULTS=20

# 详情补充：每平台每轮最多自动补充 3 个 HIGH 相关性候选（硬上限 3）
EVERYINFRA_DETAIL_ENABLED=true
EVERYINFRA_DETAIL_MAX_PER_PLATFORM=10
EVERYINFRA_DETAIL_CONCURRENCY=2

# 1688 图片搜索：默认关闭；只有用户主动触发时才调用，单次一张公网 HTTPS 图片
EVERYINFRA_1688_IMAGE_SEARCH_ENABLED=false
# 可选：覆盖 EVERYINFRA 请求超时（毫秒）；未设置时沿用 PROVIDER_HTTP_TIMEOUT_MS
# EVERYINFRA_TIMEOUT_MS=30000
# 1688 搜索实测可能需要 30–60 秒，单独使用更长超时；默认至少 60000
EVERYINFRA_1688_TIMEOUT_MS=60000

# 以下为预留服务，当前未实现 Adapter
BAMBOO_API_KEY=
SOCIALTOAI_API_KEY=

# ===== Taobao 淘宝客 =====
TAOBAO_APP_KEY=
TAOBAO_APP_SECRET=
# taobao.tbk.dg.material.optional 必需的推广位 ID
TAOBAO_ADZONE_ID=
# 可选：TOP 网关地址
TAOBAO_GATEWAY_URL=https://eco.taobao.com/router/rest

# ===== Pinduoduo 多多进宝 =====
PDD_CLIENT_ID=
PDD_CLIENT_SECRET=
PDD_ACCESS_TOKEN=
PDD_GATEWAY_URL=https://gw-api.pinduoduo.com/api/router

# ===== Playwright 浏览器采集 =====
# false 时使用可见浏览器，便于扫码登录和调试
PLAYWRIGHT_HEADLESS=false
# 可选：使用系统已安装的浏览器作为 Playwright 通道（chrome / msedge）。
# 某些环境下 Playwright 自带 Chromium 的可见窗口无法启动时，可设为 chrome。
PLAYWRIGHT_CHANNEL=
# 是否启用抖音 / 小红书的浏览器采集通道
BROWSER_PROVIDERS_ENABLED=true
# 浏览器用户数据目录（保存登录状态，已加入 .gitignore）
BROWSER_USER_DATA_DIR=.auth
# 验证码/登录拦截时最多暂停多少次等待人工处理；超过后渠道明确失败，不无限重试
BROWSER_MANUAL_VERIFICATION_MAX_ATTEMPTS=3

# ===== 可选第三方商品数据服务（预留，未实现） =====
PRODUCT_DATA_API_KEY=
PRODUCT_DATA_API_BASE_URL=

# ===== 搜索限制 =====
SEARCH_MAX_RESULTS_PER_PLATFORM=20
SEARCH_MAX_PAGES=2
# 同一平台两次请求之间的最小间隔（毫秒）
PLATFORM_REQUEST_DELAY_MS=2000
# 第三方接口超时（毫秒）
PROVIDER_HTTP_TIMEOUT_MS=30000

# ===== Uploads =====
# 参考图片上传目录（已加入 .gitignore）
UPLOAD_DIR=uploads
UPLOAD_MAX_IMAGE_MB=5

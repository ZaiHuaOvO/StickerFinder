# ===== Application =====
# 后端监听端口（前端开发代理默认指向 3000）
PORT=3000
NODE_ENV=development

# ===== Database =====
# mysql（默认，符合项目设计）或 sqlite（仅用于本机无 MySQL 时验证流程）
DB_TYPE=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=
DB_DATABASE=sticker_finder
# Demo 阶段使用 TypeORM synchronize 自动建表；生产环境应改为 false 并使用迁移。
DB_SYNCHRONIZE=true
# DB_TYPE=sqlite 时的数据库文件路径
SQLITE_PATH=data/sticker-finder.sqlite

# ===== DeepSeek =====
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
AI_CLASSIFY_ENABLED=true
# 置信度低于该值时，MATCH 结果会降级为 UNCERTAIN 交由人工确认
AI_MIN_CONFIDENCE=0.65
# 多模态（参考图 + 商品图）默认关闭；确认所用模型支持图片输入后再开启
AI_VISION_ENABLED=false
# 允许为 AI 抓取的商品图片域名（逗号分隔的域名后缀）
IMAGE_HOST_ALLOWLIST=alicdn.com,pddpic.com,taobao.com,qpic.cn,douyinpic.com,xhscdn.com

# ===== 抖音第三方数据服务：Qovia =====
QOVIA_API_KEY=
QOVIA_BASE_URL=https://api.qovia.ai

# ===== 小红书第三方数据服务：OKData =====
OKDATA_API_KEY=
OKDATA_BASE_URL=https://api.okdata.online

# 以下为预留服务，当前未实现 Adapter
BAMBOO_API_KEY=
SOCIALTOAI_API_KEY=

# 每次平台聚合最多调用 DeepSeek 做几次跨来源同款判断（0 表示关闭）
THIRD_PARTY_MAX_AI_MATCHES_PER_PLATFORM=6

# ===== Taobao 淘宝客 =====
TAOBAO_APP_KEY=
TAOBAO_APP_SECRET=
# taobao.tbk.dg.material.optional 必需的推广位 ID
TAOBAO_ADZONE_ID=
# 可选：TOP 网关地址
TAOBAO_GATEWAY_URL=https://eco.taobao.com/router/rest

# ===== Pinduoduo 多多进宝 =====
PDD_CLIENT_ID=
PDD_CLIENT_SECRET=
PDD_ACCESS_TOKEN=
PDD_GATEWAY_URL=https://gw-api.pinduoduo.com/api/router

# ===== Playwright 浏览器采集 =====
# false 时使用可见浏览器，便于扫码登录和调试
PLAYWRIGHT_HEADLESS=false
# 是否启用抖音 / 小红书的浏览器采集通道
BROWSER_PROVIDERS_ENABLED=true
# 浏览器用户数据目录（保存登录状态，已加入 .gitignore）
BROWSER_USER_DATA_DIR=.auth

# ===== 可选第三方商品数据服务（预留，未实现） =====
PRODUCT_DATA_API_KEY=
PRODUCT_DATA_API_BASE_URL=

# ===== 搜索限制 =====
SEARCH_MAX_RESULTS_PER_PLATFORM=20
SEARCH_MAX_PAGES=2
# 同一平台两次请求之间的最小间隔（毫秒）
PLATFORM_REQUEST_DELAY_MS=2000
# 第三方接口超时（毫秒）
PROVIDER_HTTP_TIMEOUT_MS=20000

# ===== Uploads =====
# 参考图片上传目录（已加入 .gitignore）
UPLOAD_DIR=uploads
UPLOAD_MAX_IMAGE_MB=5
